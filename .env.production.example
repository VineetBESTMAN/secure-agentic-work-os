# Public deployment identity. Point DNS at the host before starting Caddy.
APP_DOMAIN=workos.example.com
ACME_EMAIL=operations@example.com
APP_IMAGE_TAG=latest
APP_ACTIVE_ENCRYPTION_KEY_ID=primary

# Managed object storage. Prefer an instance/workload role over static credentials.
APP_OBJECT_STORAGE_BUCKET=workos-production
APP_OBJECT_STORAGE_PREFIX=workos
APP_OBJECT_STORAGE_REGION=us-east-1
APP_OBJECT_STORAGE_ENDPOINT_URL=
APP_OBJECT_STORAGE_FORCE_PATH_STYLE=false
APP_OBJECT_STORAGE_SSE=AES256
APP_OBJECT_STORAGE_KMS_KEY_ID=

# Backup and monitoring objectives.
APP_BACKUP_STATUS_PREFIX=backups/postgres
APP_BACKUP_RPO_SECONDS=90000
BACKUP_INTERVAL_SECONDS=86400
PROMETHEUS_RETENTION=30d
APP_JOB_MAX_ATTEMPTS=3
APP_JOB_RETRY_INTERVALS=5,30
APP_JOB_STALE_SECONDS=900
APP_CONNECTOR_READ_MAX_RETRIES=2
APP_CONNECTOR_RETRY_BASE_DELAY_SECONDS=0.25
APP_CONNECTOR_RETRY_MAX_DELAY_SECONDS=5

# Host-side Docker secret files. Never commit their contents.
APP_SECRET_KEY_FILE_HOST=.secrets/production/app-secret-key
APP_ENCRYPTION_KEYRING_FILE_HOST=.secrets/production/encryption-keyring.json
DATABASE_URL_FILE_HOST=.secrets/production/database-url
REDIS_URL_FILE_HOST=.secrets/production/redis-url
METRICS_TOKEN_FILE_HOST=.secrets/production/metrics-token
RESTORE_VERIFY_ADMIN_URL_FILE_HOST=.secrets/production/restore-admin-url
RESTORE_VERIFY_DATABASE_URL_FILE_HOST=.secrets/production/restore-database-url
RESTORE_VERIFY_DATABASE_NAME=workos_restore_verify

# Optional model configuration.
APP_EMBEDDING_PROVIDER=local
APP_MODEL_PROVIDER=deterministic
APP_GROUNDED_ANSWERS_ENABLED=true
APP_LLM_PLANNER_ENABLED=false
APP_WORKFLOW_ENGINE=langgraph
APP_LANGGRAPH_FALLBACK_ENABLED=true
APP_LANGGRAPH_RECURSION_LIMIT=64
OPENAI_API_KEY=
